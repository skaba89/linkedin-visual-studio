DATABASE_URL=postgresql://hermes:hermes@localhost:5432/hermes

# Encryption key for LinkedIn token encryption (generate: openssl rand -hex 32)
ENCRYPTION_KEY=

# NextAuth secret for JWT signing (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=hermes-dev-secret-change-in-production

# Public URL of the app
NEXTAUTH_URL=http://localhost:3000
