# ─── Database (Neon PostgreSQL) ──────────────────────────────────────
# Get your connection string from: https://console.neon.tech
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/hermes?sslmode=require
DATABASE_URL=

# ─── Encryption (R-004) ─────────────────────────────────────────────
# AES-256-GCM key used to encrypt sensitive data at rest:
#  - LinkedIn OAuth tokens (LinkedInAuth.accessToken column)
#  - LinkedIn tokens in httpOnly cookies
# REQUIRED in production — the server will throw on encrypt/decrypt if unset.
# Generate with: openssl rand -hex 32   (→ 64-char hex string)
# OR:            openssl rand -base64 32 (→ 44-char base64 string)
# Rotation: change the key + run `npx tsx scripts/migrate-encrypt-linkedin-tokens.ts`
# WARNING: changing this key invalidates all existing encrypted tokens.
ENCRYPTION_KEY=

# ─── NextAuth.js ───────────────────────────────────────────────────
# Secret for JWT signing & encryption.
# REQUIRED in production — the server will refuse to boot if unset.
# Generate with: openssl rand -base64 32
# In development only, a fallback dev secret is used (see src/lib/auth-config.ts).
NEXTAUTH_SECRET=

# Public URL of the application
# LOCAL: http://localhost:3000
# RENDER: https://linkedin-visual-studio.onrender.com
NEXTAUTH_URL=http://localhost:3000

# ─── Optional LLM Provider API Keys ────────────────────────────────
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ─── Phase 1.5 — Cron jobs ────────────────────────────────────────
# Secret used to authenticate cron job requests (x-cron-secret header)
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── LinkedIn OAuth (for posting on behalf of users) ──────────────
# Create a LinkedIn app at: https://www.linkedin.com/developers/apps/new
# Redirect URL: https://your-app.onrender.com/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── Phase 4.2 — Stripe billing (optional, for SaaS monetization) ──
# Create a Stripe account at: https://dashboard.stripe.com/register
# Get your secret key + webhook signing secret from the Stripe dashboard.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Create 6 recurring prices (3 plans × 2 intervals) in the Stripe dashboard
# and set their price IDs here. The free plan has no Stripe price.
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_YEARLY=price_...
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
# STRIPE_PRICE_ENTERPRISE_YEARLY=price_...
