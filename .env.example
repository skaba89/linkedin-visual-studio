# ─── Database (Neon PostgreSQL) ──────────────────────────────────────
# Get your connection string from: https://console.neon.tech
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/hermes?sslmode=require
DATABASE_URL=

# ─── Encryption ─────────────────────────────────────────────────────
# Used for LinkedIn OAuth token encryption (required in production)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── NextAuth.js ───────────────────────────────────────────────────
# Secret for JWT signing & encryption.
# REQUIRED in production — the server will refuse to boot if unset.
# Generate with: openssl rand -base64 32
# In development only, a fallback dev secret is used (see src/lib/auth-config.ts).
NEXTAUTH_SECRET=

# Public URL of the application
# LOCAL: http://localhost:3000
# RENDER: https://linkedin-visual-studio.onrender.com
NEXTAUTH_URL=http://localhost:3000

# ─── Optional LLM Provider API Keys ────────────────────────────────
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
