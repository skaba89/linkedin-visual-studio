# ─── Database ───────────────────────────────────────────────────────
# LOCAL (SQLite):
# DATABASE_URL=file:./db/custom.db
#
# RENDER (PostgreSQL — auto-injected by Render):
# DATABASE_URL=postgresql://user:password@host:port/hermes_db
DATABASE_URL=file:./db/custom.db

# ─── Encryption ─────────────────────────────────────────────────────
# Used for LinkedIn OAuth token encryption (required in production)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── NextAuth.js ───────────────────────────────────────────────────
# Secret for JWT signing & encryption (required in production)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of the application
# LOCAL: http://localhost:3000
# RENDER: https://hermes-app-xxxx.onrender.com
NEXTAUTH_URL=http://localhost:3000

# ─── Optional LLM Provider API Keys ────────────────────────────────
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
